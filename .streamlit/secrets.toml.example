# Copie este archivo como secrets.toml (NO lo suba a GitHub).
# En Streamlit Cloud: Settings > Secrets, pegue este mismo contenido.
SHEET_ID = "id_de_su_google_sheet"   # lo que va entre /d/ y /edit en la URL
PIN_SALT = "cambie-esta-frase-por-una-propia-y-larga"   # no la comparta

[gcp_service_account]
type = "service_account"
project_id = "..."
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "...@....iam.gserviceaccount.com"
client_id = "..."
token_uri = "https://oauth2.googleapis.com/token"
